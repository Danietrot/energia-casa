{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energia-casa",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "keep_vars": true,

  "vars": {
    "THINGSPEAK_CHANNEL_ID": "3493335",
    "TIME_ZONE": "Europe/Rome"
  },

  "secrets": {
    "required": [
      "THINGSPEAK_READ_API_KEY"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "ENERGY_KV"
    }
  ]
}
